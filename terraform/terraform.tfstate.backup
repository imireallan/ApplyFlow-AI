            "metadata_fingerprint": "IJ3mL22fTDk=",
            "metadata_startup_script": "#!/bin/bash\nset -e\n\n# GCP Debian 12 startup script — GCR architecture (matches deploy.yml)\n# Not ECR; pulls GCR images; uses apt (not dnf)\n\nexport DEBIAN_FRONTEND=noninteractive\napt-get update -y\napt-get install -y docker.io docker-compose git curl make\n\nsystemctl enable docker\nsystemctl start docker\n\nfallocate -l 2G /swapfile || true\nchmod 600 /swapfile || true\nmkswap /swapfile || true\nswapon /swapfile || true\necho '/swapfile none swap sw 0 0' \u003e\u003e /etc/fstab\n\nusermod -aG docker debian || true\nmkdir -p /usr/libexec/docker/cli-plugins || true\ncurl -SL https://github.com/docker/compose/releases/download/v2.27.0/docker-compose-linux-x86_64 \\\n  -o /usr/libexec/docker/cli-plugins/docker-compose || echo \"docker-compose plugin skip\"\nchmod +x /usr/libexec/docker/cli-plugins/docker-compose || true\n\nmkdir -p /home/debian/applyflow || true\nchown debian:debian /home/debian/applyflow || true\n\n# GCR auth (before pulling GCR images from deploy.yaml)\ngcloud auth configure-docker gcr.io || echo \"GCR auth skipped\"\n\n# For local/development use (before pushing): use existing local files; skip remote clone\n# If running locally (repo already present), don't clone; just ensure .env exists and compose runs\nif [ -d \"/home/debian/applyflow/.git\" ]; then\n  echo \"Repo already present locally; skipping clone\"\n  git pull origin main || echo \"Local pull skipped (not pushed yet)\"\nelse\n  # For GCP deploy: clone from remote (only if missing and pushed)\n  git clone https://github.com/imireallan/ApplyFlow-AI.git . || echo \"Repo clone skipped (not pushed / local only)\"\nfi\n\n# Ensure .env exists in app dir (deploy.yml writes it; for manual/startup, copy from repo)\nif [ ! -f \"/home/debian/applyflow/.env\" ]; then\n  cp /home/debian/applyflow/.env.example /home/debian/applyflow/.env 2\u003e/dev/null || echo \".env not present; deploy.yml should provide it\"\nfi\n\n# Pull GCR images and start (matches deploy.yml GCR logic)\ndocker compose pull || echo \"docker compose pull skipped (GCR images may need push first)\"\ndocker compose up -d db || echo \"DB start skipped\"\n# Note: deploy.yml handles ai_engine + alembic + full rollout; instance startup prepares environment\n",
